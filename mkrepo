#!/bin/sh
#
# mkrepo - build the recipes under pkg/ into a binary repo for rpk
#
# usage: mkrepo OUTDIR [name ...]
#
# CC has to be a musl compiler (mklive hands over its musl-gcc). A
# package already sitting in OUTDIR at the recipe's version is left
# alone, so rerunning only builds what changed.
#
# A recipe is pkg/<name>/build, a shell file that sets
#
#   version, release, description
#   depends       what it needs at runtime (other packages)
#   makedepends   what it needs to build: packages, or build-only libs
#   source        a URL. Tarballs get unpacked, anything else is copied
#   sha256        of that source
#   buildonly=1   a library other recipes link against, never packaged
#
# and has a build() function. build() runs inside the unpacked source
# with $pkg as the install root, $files pointing at the recipe's
# directory, $stage holding everything built so far (headers, static
# libs, .pc files) and $JOBS for make.

set -e

top=$(cd "$(dirname "$0")" && pwd)
[ "$1" ] || { echo "usage: mkrepo OUTDIR [name ...]" >&2; exit 1; }
mkdir -p "$1"
out=$(cd "$1" && pwd)
shift

work=${WORK:-$top/work}
stage=$work/stage
export JOBS="${JOBS:-$(nproc)}"
: "${CC:?point CC at a musl compiler, e.g. CC=/path/to/musl-gcc}"
export CC

# everything here is static: there is no musl dynamic loader on the
# system, so a dynamically linked binary wouldn't even start. And
# whatever earlier recipes built is there to link against.
export LDFLAGS="-static -L$stage/usr/lib${LDFLAGS:+ $LDFLAGS}"
export CPPFLAGS="-I$stage/usr/include${CPPFLAGS:+ $CPPFLAGS}"
export PKG_CONFIG_LIBDIR=$stage/usr/lib/pkgconfig
export PKG_CONFIG_SYSROOT_DIR=$stage

msg() { printf '\033[1;35m=>\033[m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[m %s\n' "$*" >&2; exit 1; }

load() {
    unset version release description depends makedepends source \
          sha256 buildonly
    [ -f "$top/pkg/$1/build" ] || die "no recipe for $1"
    . "$top/pkg/$1/build"
}

staged() {
    [ -f "$stage/.built/$1" ]
}

# build_pkg NAME [stage]
#
# Build NAME unless the repo already has it at this version. With
# "stage" it's being built for another recipe to link against, and what
# matters is that its files are in $stage.
build_pkg() (
    name=$1
    load "$name"
    id=$name-$version-$release
    file=$out/$id.tar.xz

    pack=1
    { [ -n "$buildonly" ] || [ -f "$file" ]; } && pack=
    need_stage=
    [ "$2" = stage ] && ! staged "$id" && need_stage=1

    if [ -z "$pack" ] && [ -z "$need_stage" ]; then
        [ "$2" = stage ] || msg "$name $version-$release is up to date"
        exit 0
    fi

    for dep in $makedepends; do
        build_pkg "$dep" stage
    done

    src=$work/src/$name/${source##*/}
    mkdir -p "${src%/*}"
    if [ ! -f "$src" ]; then
        msg "fetching $name $version"
        curl -fL --retry 3 -o "$src.part" "$source"
        mv "$src.part" "$src"
    fi
    echo "$sha256  $src" | sha256sum -c --status - ||
        die "bad checksum for ${src##*/}"

    dir=$work/$name
    rm -rf "$dir"
    mkdir -p "$dir/src" "$dir/pkg"
    case $src in
        *.tar.*|*.tgz) tar -xf "$src" -C "$dir/src" --strip-components=1 ;;
        *)             cp "$src" "$dir/src/" ;;
    esac

    msg "building $name $version"
    pkg=$dir/pkg
    files=$top/pkg/$name
    cd "$dir/src"
    # not "if ! (build)": set -e is switched off inside an if condition,
    # and a recipe has to stop at the first thing that fails
    set +e
    (set -e; build) > "$dir/build.log" 2>&1
    status=$?
    set -e
    if [ "$status" -ne 0 ]; then
        tail -n 40 "$dir/build.log"
        die "$name didn't build, the whole log is in $dir/build.log"
    fi
    [ -n "$(ls -A "$pkg")" ] || die "$name built but installed nothing"

    # headers, static libs and all, for whatever builds against it next
    mkdir -p "$stage/.built"
    cp -a "$pkg/." "$stage/"
    : > "$stage/.built/$id"

    if [ -n "$buildonly" ]; then
        msg "$name $version is ready to build against"
        exit 0
    fi
    [ -n "$pack" ] || exit 0

    # no man(1) on the system to read these with, and nothing links
    # against the static libs at runtime
    rm -rf "$pkg/usr/share/man" "$pkg/usr/share/info" "$pkg/usr/share/doc" \
           "$pkg/usr/share/aclocal" "$pkg/usr/include" "$pkg/usr/lib/pkgconfig"
    find "$pkg" \( -name '*.a' -o -name '*.la' \) -delete
    find "$pkg" -type f -perm -u+x -exec strip --strip-all {} + 2>/dev/null || :
    find "$pkg" -mindepth 1 -depth -type d -empty -delete

    # there's no dynamic loader on raye, a dynamic binary can't even start
    dyn=$(find "$pkg" -type f -exec file {} + | grep 'dynamically linked' |
        cut -d: -f1 | sed "s|^$pkg||") || :
    [ -z "$dyn" ] || die "$name has dynamically linked binaries:
$dyn"

    cd "$pkg"
    find . -mindepth 1 | sed 's|^\./||' | sort > "$dir/list"
    rm -f "$out/$name"-[0-9]*.tar.xz
    tar --numeric-owner --owner=0 --group=0 --no-recursion \
        -cJf "$file.part" -T "$dir/list"
    mv "$file.part" "$file"
    msg "$name: $(du -h "$file" | cut -f1)"
)

[ "$#" -gt 0 ] || set -- $(ls "$top/pkg")

for name do
    build_pkg "$name"
done

: > "$out/INDEX.part"
for d in "$top"/pkg/*/; do
    name=${d%/}
    name=${name##*/}
    load "$name"
    file=$name-$version-$release.tar.xz
    [ -f "$out/$file" ] || continue

    sum=$(sha256sum "$out/$file" | cut -d' ' -f1)
    printf '%s|%s|%s|%s|%s\n' "$name" "$version-$release" "$sum" \
        "$depends" "$description" >> "$out/INDEX.part"
done
mv "$out/INDEX.part" "$out/INDEX"
msg "$(wc -l < "$out/INDEX") packages in $out"
