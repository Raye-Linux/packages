#!/bin/sh
#
# mkrepo - build the recipes under pkg/ into a binary repo for rpk
#
# usage: mkrepo OUTDIR [name ...]
#
# CC and CXX have to be a musl toolchain (mklive hands over the one it
# builds). A package already sitting in OUTDIR at the recipe's version
# is left alone, so rerunning only builds what changed.
#
# A recipe is pkg/<name>/build, a shell file that sets
#
#   version, release, description
#   depends       what it needs at runtime (other packages)
#   makedepends   what it needs to build: packages, or build-only libs
#   source        a URL. Tarballs get unpacked, anything else is copied.
#                 git+URL#COMMIT clones URL at that commit instead
#   sha256        of that source (not for git ones, the commit pins those)
#   buildonly=1   a library other recipes link against, never packaged
#   dynamic=1     link against shared libraries rather than statically
#
# and has a build() function. build() runs inside the unpacked source
# with $pkg as the install root, $files pointing at the recipe's
# directory, $stage holding everything built so far (headers, libs, .pc
# files) and $JOBS for make.
#
# Static is the default and most things stay that way. The dynamic ones
# are cross builds as far as their build systems are concerned (the build
# machine can't start a musl binary on its own), so they get --host=$TARGET
# for configure, --cross-file "$MESON_CROSS" for meson and
# -DCMAKE_TOOLCHAIN_FILE="$CMAKE_TOOLCHAIN" for cmake. meson_build and
# cmake_build do the usual setup, build and install with those, taking
# the project's own options as arguments. "$RUN" PROGRAM runs something
# just built, when a recipe has to (generating a cache, say), with
# RUN_LIBS for libraries it needs that aren't staged yet.
#
# Whatever they link has to come from a package in depends, or from musl
# and gcc-libs, which mklive puts in OUTDIR before it calls this.

set -e

top=$(cd "$(dirname "$0")" && pwd)
[ "$1" ] || { echo "usage: mkrepo OUTDIR [name ...]" >&2; exit 1; }
mkdir -p "$1"
out=$(cd "$1" && pwd)
shift

work=${WORK:-$top/work}
stage=$work/stage
export JOBS="${JOBS:-$(nproc)}"
: "${CC:?point CC at a musl compiler, e.g. CC=/path/to/x86_64-linux-musl-gcc}"
CXX=${CXX:-${CC%gcc}g++}
TARGET=$("$CC" -dumpmachine)
export CC CXX TARGET

# whatever earlier recipes built is there to link against. -static goes
# in front of this for everything that isn't dynamic=1. The C++ runtime's
# directory too: a C program linking a C++ library still has to find
# libstdc++ behind it
cxxlib=$(dirname "$("$CXX" -print-file-name=libstdc++.so.6)")
ldflags="-L$stage/usr/lib -Wl,-rpath-link,$stage/usr/lib -Wl,-rpath-link,$cxxlib${LDFLAGS:+ $LDFLAGS}"
export CPPFLAGS="-I$stage/usr/include${CPPFLAGS:+ $CPPFLAGS}"
export PKG_CONFIG_LIBDIR=$stage/usr/lib/pkgconfig:$stage/usr/share/pkgconfig
export PKG_CONFIG_SYSROOT_DIR=$stage

msg() { printf '\033[1;35m=>\033[m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[m %s\n' "$*" >&2; exit 1; }

load() {
    unset version release description depends makedepends source \
          sha256 buildonly dynamic
    [ -f "$top/pkg/$1/build" ] || die "no recipe for $1"
    . "$top/pkg/$1/build"
}

staged() {
    [ -f "$stage/.built/$1" ]
}

# Build systems run what they build now and then (tests, little code
# generators). Static binaries just run; dynamic ones go through musl's
# loader, pointed at the staged libraries, since the build machine has
# no /lib/ld-musl-* of its own.
tools() {
    mkdir -p "$work"
    ldso=$("$CC" -print-sysroot)/usr/lib/libc.so
    cat > "$work/run" <<EOF
#!/bin/sh
case \$(readelf -l "\$1" 2>/dev/null) in
    *'program interpreter'*)
        exec "$ldso" --library-path "\${RUN_LIBS:+\$RUN_LIBS:}$stage/usr/lib:$cxxlib" "\$@" ;;
esac
exec "\$@"
EOF
    chmod +x "$work/run"
    export RUN="$work/run"

    # shellcheck disable=SC2086
    largs=$(printf "'%s', " $ldflags | sed 's/, $//')
    cat > "$work/meson.cross" <<EOF
[binaries]
c = '$CC'
cpp = '$CXX'
ar = '$("$CC" -print-prog-name=ar)'
strip = '$("$CC" -print-prog-name=strip)'
pkg-config = 'pkg-config'
exe_wrapper = '$work/run'

[host_machine]
system = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[properties]
# same cpu as the build machine, but it still can't start these alone
needs_exe_wrapper = true
pkg_config_libdir = ['$stage/usr/lib/pkgconfig', '$stage/usr/share/pkgconfig']
sys_root = '$stage'

[built-in options]
prefix = '/usr'
libdir = 'lib'
buildtype = 'release'
wrap_mode = 'nodownload'
c_args = ['-I$stage/usr/include']
cpp_args = ['-I$stage/usr/include']
c_link_args = [$largs]
cpp_link_args = [$largs]
EOF

    cat > "$work/cmake.toolchain" <<EOF
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER $CC)
set(CMAKE_CXX_COMPILER $CXX)
set(CMAKE_C_FLAGS_INIT "-I$stage/usr/include")
set(CMAKE_CXX_FLAGS_INIT "-I$stage/usr/include")
set(CMAKE_FIND_ROOT_PATH $stage)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CROSSCOMPILING_EMULATOR $work/run)
set(CMAKE_INSTALL_PREFIX /usr CACHE PATH "")
set(CMAKE_INSTALL_LIBDIR lib CACHE PATH "")
set(CMAKE_BUILD_TYPE Release CACHE STRING "")
EOF
    # things meson looks for "native: true" (wayland-scanner, glib's code
    # generators, protocol XML) are the staged ones as well, run through
    # the wrappers below
    cat > "$work/meson.native" <<EOF
[properties]
pkg_config_libdir = ['$stage/usr/lib/pkgconfig', '$stage/usr/share/pkgconfig']
sys_root = '$stage'
EOF
    export MESON_CROSS="$work/meson.cross" CMAKE_TOOLCHAIN="$work/cmake.toolchain"
}

# for recipes: meson_build OPTION..., cmake_build OPTION...
meson_build() {
    meson setup _build --cross-file "$MESON_CROSS" \
        --native-file "$work/meson.native" "$@"
    meson compile -C _build -j "$JOBS"
    DESTDIR="$pkg" meson install -C _build --no-rebuild
}

cmake_build() {
    cmake -S . -B _build -G Ninja -DCMAKE_TOOLCHAIN_FILE="$CMAKE_TOOLCHAIN" "$@"
    cmake --build _build -j "$JOBS"
    DESTDIR="$pkg" cmake --install _build
}

# wrap_tools DIR: in the stage, swap every dynamic executable that came
# from DIR for a script that runs it through the loader, so whatever
# builds next can use it as a build tool (wayland-scanner and friends)
wrap_tools() {
    find "$1/usr/bin" "$1/usr/libexec" -type f 2>/dev/null | while read -r f; do
        readelf -l "$f" 2>/dev/null | grep -q 'program interpreter' || continue
        s=$stage${f#$1}
        mkdir -p "${s%/*}/.musl"
        mv "$s" "${s%/*}/.musl/${s##*/}"
        printf '#!/bin/sh\nexec "%s" "%s" "$@"\n' "$work/run" \
            "${s%/*}/.musl/${s##*/}" > "$s"
        chmod +x "$s"
    done
}

# fetch: get $source into $work/src, checked against $sha256 or, for a
# git source, its commit. Sets $src to the tarball or the checkout
fetch() {
    case $source in
    git+*)
        url=${source#git+}
        url=${url%#*}
        commit=${source##*#}
        src=$work/src/$name/$commit
        if [ ! -d "$src" ]; then
            msg "cloning $name $version"
            rm -rf "$src.part"
            git init -q "$src.part"
            git -C "$src.part" fetch -q --depth 1 "$url" "$commit"
            git -C "$src.part" checkout -q FETCH_HEAD
            git -C "$src.part" submodule -q update --init --recursive --depth 1
            mv "$src.part" "$src"
        fi
        [ "$(git -C "$src" rev-parse HEAD)" = "$commit" ] ||
            die "$name isn't at $commit"
        ;;
    *)
        src=$work/src/$name/${source##*/}
        mkdir -p "${src%/*}"
        if [ ! -f "$src" ]; then
            msg "fetching $name $version"
            curl -fL --retry 3 -o "$src.part" "$source"
            mv "$src.part" "$src"
        fi
        echo "$sha256  $src" | sha256sum -c --status - ||
            die "bad checksum for ${src##*/}"
        ;;
    esac
}

# provides NAME...: the file names NAME and everything it depends on
# put on the system, going by the packages already in the repo
provides() (
    for d do
        if [ -f "$top/pkg/$d/build" ]; then
            load "$d"
            f=$out/$d-$version-$release.tar.xz
            deps=$depends
        else
            # musl and gcc-libs, which come out of the toolchain
            f=$(ls "$out/$d"-[0-9]*.tar.xz 2>/dev/null | tail -n 1)
            deps=
        fi
        [ -f "$f" ] || die "$d isn't in $out, build it first"
        tar -tJf "$f" | sed 's|.*/||'
        # shellcheck disable=SC2086
        [ -z "$deps" ] || provides $deps
    done
)

# build_pkg NAME [stage]
#
# Build NAME unless the repo already has it at this version. With
# "stage" it's being built for another recipe to link against, and what
# matters is that its files are in $stage.
build_pkg() (
    name=$1
    load "$name"
    id=$name-$version-$release
    file=$out/$id.tar.xz

    pack=1
    { [ -n "$buildonly" ] || [ -f "$file" ]; } && pack=
    need_stage=
    [ "$2" = stage ] && ! staged "$id" && need_stage=1

    if [ -z "$pack" ] && [ -z "$need_stage" ]; then
        [ "$2" = stage ] || msg "$name $version-$release is up to date"
        exit 0
    fi

    for dep in $makedepends; do
        build_pkg "$dep" stage
    done

    fetch
    dir=$work/$name
    rm -rf "$dir"
    mkdir -p "$dir/src" "$dir/pkg"
    if [ -d "$src" ]; then
        cp -a "$src/." "$dir/src/"
    else
        case $src in
            *.tar.*|*.tgz) tar -xf "$src" -C "$dir/src" --strip-components=1 ;;
            *)             cp "$src" "$dir/src/" ;;
        esac
    fi

    msg "building $name $version"
    if [ -n "$dynamic" ]; then
        export LDFLAGS="$ldflags"
    else
        export LDFLAGS="-static $ldflags"
    fi
    pkg=$dir/pkg
    files=$top/pkg/$name
    cd "$dir/src"
    # not "if ! (build)": set -e is switched off inside an if condition,
    # and a recipe has to stop at the first thing that fails
    set +e
    (set -e; build) > "$dir/build.log" 2>&1
    status=$?
    set -e
    if [ "$status" -ne 0 ]; then
        tail -n 40 "$dir/build.log"
        die "$name didn't build, the whole log is in $dir/build.log"
    fi
    [ -n "$(ls -A "$pkg")" ] || die "$name built but installed nothing"

    # an install dir that came from a pkg-config variable has the stage
    # in front of it. Put whatever landed there where it belongs
    if [ -d "$pkg$stage" ]; then
        cp -a "$pkg$stage/." "$pkg/"
        top_dir=${stage#/}
        rm -rf "${pkg:?}/${top_dir%%/*}"
    fi

    # headers, libs and all, for whatever builds against it next. Not the
    # .la files: they point libtool at /usr/lib, which here is the host's
    find "$pkg" -name '*.la' -delete
    mkdir -p "$stage/.built" "$stage/.files"
    # what an older build of this recipe staged goes first, or a changed
    # recipe ends up building against its own leftovers
    if [ -f "$stage/.files/$name" ]; then
        while IFS= read -r f; do
            rm -f "$stage/$f"
        done < "$stage/.files/$name"
    fi
    cp -a "$pkg/." "$stage/"
    (cd "$pkg" && find . ! -type d) > "$stage/.files/$name"
    [ -z "$dynamic" ] || wrap_tools "$pkg"
    : > "$stage/.built/$id"
    # the log stays, the unpacked source is only taking up room now
    cd "$work"
    rm -rf "$dir/src"

    if [ -n "$buildonly" ]; then
        msg "$name $version is ready to build against"
        exit 0
    fi
    [ -n "$pack" ] || exit 0

    # no man(1) on the system to read these with, and nothing links
    # against the static libs at runtime
    rm -rf "$pkg/usr/share/man" "$pkg/usr/share/info" "$pkg/usr/share/doc" \
           "$pkg/usr/share/aclocal" "$pkg/usr/include" "$pkg/usr/lib/pkgconfig" \
           "$pkg/usr/share/pkgconfig" "$pkg/usr/share/gtk-doc"
    find "$pkg" -name '*.a' -delete
    # libraries keep the symbols other things link against
    find "$pkg" -type f -name '*.so*' -exec strip --strip-unneeded {} + 2>/dev/null || :
    find "$pkg" -type f -perm -u+x ! -name '*.so*' \
        -exec strip --strip-all {} + 2>/dev/null || :
    find "$pkg" -mindepth 1 -depth -type d -empty -delete

    elves=$(find "$pkg" -type f -exec file {} + | grep ': *ELF' | cut -d: -f1) || :
    if [ -z "$dynamic" ]; then
        # a static recipe that went dynamic by accident would only find
        # out on a system that doesn't have its libraries
        dyn=$(echo "$elves" | xargs -r file | grep 'dynamically linked' |
            cut -d: -f1 | sed "s|^$pkg||") || :
        [ -z "$dyn" ] || die "$name has dynamically linked binaries:
$dyn"
    elif [ -n "$elves" ]; then
        # everything it links has to be on the system once it's
        # installed, and the loader has to be musl's, not the build host's
        # shellcheck disable=SC2086
        have=$( (find "$pkg" -name '*.so*' | sed 's|.*/||'; provides $depends) |
            sort -u)
        bad=
        for f in $elves; do
            interp=$(readelf -l "$f" | sed -n 's/.*interpreter: \(.*\)]$/\1/p')
            case $interp in
                ''|/lib/ld-musl-x86_64.so.1) ;;
                *) bad="$bad
  ${f#$pkg} wants $interp" ;;
            esac
            for lib in $(readelf -d "$f" | sed -n 's/.*(NEEDED).*\[\(.*\)\]$/\1/p'); do
                echo "$have" | grep -qxF "$lib" || bad="$bad
  ${f#$pkg} needs $lib"
            done
        done
        [ -z "$bad" ] || die "$name links against things nothing in depends has:$bad"
    fi

    cd "$pkg"
    find . -mindepth 1 | sed 's|^\./||' | sort > "$dir/list"
    rm -f "$out/$name"-[0-9]*.tar.xz
    tar --numeric-owner --owner=0 --group=0 --no-recursion \
        -cJf "$file.part" -T "$dir/list"
    mv "$file.part" "$file"
    msg "$name: $(du -h "$file" | cut -f1)"
)

tools
[ "$#" -gt 0 ] || set -- $(ls "$top/pkg")

for name do
    build_pkg "$name"
done

: > "$out/INDEX.part"
for d in "$top"/pkg/*/; do
    name=${d%/}
    name=${name##*/}
    load "$name"
    file=$name-$version-$release.tar.xz
    [ -f "$out/$file" ] || continue

    sum=$(sha256sum "$out/$file" | cut -d' ' -f1)
    printf '%s|%s|%s|%s|%s\n' "$name" "$version-$release" "$sum" \
        "$depends" "$description" >> "$out/INDEX.part"
done
mv "$out/INDEX.part" "$out/INDEX"
msg "$(wc -l < "$out/INDEX") packages in $out"
