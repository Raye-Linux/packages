# No Xwayland and no systemd. hyprpm builds plugins from git at runtime,
# which isn't how things get onto raye. libuuid comes in static from
# util-linux.
build() {
    cmake_build -DNO_XWAYLAND=ON -DNO_SYSTEMD=ON -DNO_UWSM=ON -DNO_HYPRPM=ON \
        -DBUILD_TESTING=OFF
    # 48M of default wallpapers, the rest of the package is 15. Hyprland
    # copes without them, and hyprpaper is the way to set your own
    rm -f "$pkg"/usr/share/hypr/wall*.png
    install -Dm755 "$files/session" "$pkg/usr/bin/hyprland-session"
}
