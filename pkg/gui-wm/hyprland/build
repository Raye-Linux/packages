makedepends="dev-libs/hyprwire sys-libs/readline sys-libs/ncurses gui-libs/aquamarine dev-libs/hyprlang gui-libs/hyprcursor gui-libs/hyprutils gui-libs/hyprgraphics x11-libs/libxkbcommon dev-libs/wayland dev-libs/wayland-protocols x11-libs/cairo x11-libs/pango x11-libs/pixman x11-libs/libxcursor x11-libs/libdrm dev-libs/libinput dev-libs/libei media-libs/mesa media-libs/libglvnd dev-libs/glib dev-libs/re2 dev-cpp/muparser media-libs/lcms2 dev-lang/lua dev-util/glslang dev-cpp/glaze dev-util/hyprwayland-scanner dev-libs/hyprland-protocols sys-apps/util-linux"
