# For swaync and what libadwaita needs. Wayland and GL only: no X11, no
# Vulkan renderer (that wants glslc to build), no GStreamer for video,
# no printing. Its introspection data is what libadwaita's and
# gtk4-layer-shell's Vala bindings are made from
build() {
    meson_build \
        -Dx11-backend=false -Dwayland-backend=true -Dbroadway-backend=false \
        -Dmedia-gstreamer=disabled -Dprint-cpdb=disabled -Dprint-cups=disabled \
        -Dvulkan=disabled -Dcloudproviders=disabled -Dsysprof=disabled \
        -Dtracker=disabled -Dcolord=disabled -Daccesskit=disabled \
        -Dintrospection=enabled -Ddocumentation=false -Dscreenshots=false \
        -Dman-pages=false -Dbuild-demos=false -Dbuild-testsuite=false \
        -Dbuild-examples=false -Dbuild-tests=false
    # the schemas get compiled by glib's hook, like GTK 3's
}
