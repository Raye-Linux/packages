makedepends="dev-libs/glib x11-libs/pango media-libs/harfbuzz dev-libs/fribidi x11-libs/cairo x11-libs/gdk-pixbuf media-libs/libpng media-libs/libjpeg-turbo media-libs/libtiff media-libs/libepoxy media-libs/graphene x11-libs/libxkbcommon dev-libs/wayland dev-libs/wayland-protocols x11-libs/libdrm media-libs/fontconfig media-libs/freetype dev-libs/glib-gir x11-libs/pango-gir media-libs/harfbuzz-gir x11-libs/gdk-pixbuf-gir dev-libs/gobject-introspection"
