# The real hyprland-share-picker is Qt6, all of it for one dialog. A
# small script by the same name stands in, with slurp: it shares whole
# outputs, windows and regions need the real one
build() {
    sed -i -e '/add_subdirectory(hyprland-share-picker)/d' \
        -e '/install(TARGETS hyprland-share-picker)/d' CMakeLists.txt
    cmake_build
    install -Dm755 "$files/picker" "$pkg/usr/bin/hyprland-share-picker"
}
