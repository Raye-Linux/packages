version=1.10.0
release=1
description="libadwaita, GNOME's widgets on top of GTK 4"
depends="musl glib gtk4 fribidi"
makedepends="glib gtk4 fribidi glib-gir pango-gir harfbuzz-gir gdk-pixbuf-gir gobject-introspection vala"
dynamic=1
source="https://download.gnome.org/sources/libadwaita/${version%.*}/libadwaita-$version.tar.xz"
sha256=b1bf56239269d101a6391ad4553c910eff9cc6170b803916405477ef60a66c84

# For swaync, and its Vala bindings are the reason for the introspection
# data. vapigen is the native one from the vala recipe, and finds the
# .gir files of GTK and friends in the stage. ministream, the small
# AppStream reader it uses for its About dialog, is in the tarball and
# goes in statically.
build() {
    PATH="$work/native/bin:$PATH" XDG_DATA_DIRS="$stage/usr/share" \
        meson_build -Dintrospection=enabled -Dvapi=true -Dtests=false \
        -Dexamples=false -Ddocumentation=false
}
