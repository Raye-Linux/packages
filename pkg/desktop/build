version=1
release=2
description="the whole Hyprland desktop in one go, with Raye's default look"
depends="hyprland foot waybar swaync rofi hyprlock hypridle hyprpaper grim slurp wl-clipboard pipewire wireplumber wpa_supplicant xdg-desktop-portal xdg-desktop-portal-hyprland xdg-desktop-portal-gtk flatpak seatd eudev dbus font-dejavu adwaita-icon-theme"

# Nothing to compile: the configs go to /etc/xdg, where every one of
# these programs looks only after ~/.config. swaync's colours are in its
# own recipe, it only takes one stylesheet from /etc/xdg.
build() {
    x=$pkg/etc/xdg
    for f in hyprland hyprlock hypridle hyprpaper; do
        install -Dm644 "$files/$f.conf" "$x/hypr/$f.conf"
    done
    install -Dm644 "$files/waybar/config.jsonc" "$x/waybar/config.jsonc"
    install -Dm644 "$files/waybar/style.css" "$x/waybar/style.css"
    install -Dm644 "$files/foot.ini" "$x/foot/foot.ini"
    install -Dm644 "$files/rofi.rasi" "$x/rofi.rasi"
    install -Dm644 "$files/gtk-3.0/settings.ini" "$x/gtk-3.0/settings.ini"
    install -Dm644 "$files/wallpaper.png" "$pkg/usr/share/backgrounds/raye.png"
    # zz: last of the profile snippets, it doesn't come back from exec
    install -Dm644 "$files/profile" "$pkg/etc/profile.d/zz-desktop.sh"
}
