version=1.22.1
release=1
description="the portal: how sandboxed apps open files, take screenshots, share screens"
depends="musl glib json-glib fuse3 gdk-pixbuf gstreamer gst-plugins-base pipewire"
makedepends="glib json-glib fuse3 gdk-pixbuf gstreamer gst-plugins-base pipewire flatpak"
dynamic=1
source="https://github.com/flatpak/xdg-desktop-portal/releases/download/$version/xdg-desktop-portal-$version.tar.xz"
sha256=d4879ddb3d65ff1a8f19187497e6f13dc5d267bcac404a5d501218be355753d3

# the backends that do the actual work are xdg-desktop-portal-hyprland
# and -gtk
build() {
    meson_build \
        -Dflatpak-interfaces=enabled \
        -Dgeoclue=disabled \
        -Dgudev=disabled \
        -Dsystemd=disabled \
        -Dsandboxed-image-validation=disabled \
        -Dsandboxed-sound-validation=disabled \
        -Ddocumentation=disabled \
        -Dman-pages=disabled \
        -Dtests=disabled \
        -Dinstalled-tests=false
}
