#!/bin/sh
#
# GSettings schemas and GIO modules come from all sorts of packages, and
# GLib only reads the compiled forms. Quietly: gsettings-desktop-schemas
# alone brings a page of deprecation warnings, and the exit status says
# well enough whether it worked.

status=0
if [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || status=1
fi
if [ -d /usr/lib/gio/modules ]; then
    gio-querymodules /usr/lib/gio/modules || status=1
fi
exit $status
