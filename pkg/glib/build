version=2.90.1
release=1
description="GLib, GObject and GIO, the base of the GTK world"
depends="musl libffi pcre2 zlib"
makedepends="libffi pcre2 zlib"
dynamic=1
source="https://download.gnome.org/sources/glib/${version%.*}/glib-$version.tar.xz"
sha256=93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396

# no gettext on the system, so no translations. libmount would drag the
# rest of util-linux in for one GIO feature nobody here uses
build() {
    meson_build \
        -Dintrospection=disabled \
        -Dnls=disabled \
        -Dlibmount=disabled \
        -Dselinux=disabled \
        -Dsysprof=disabled \
        -Dlibelf=disabled \
        -Dman-pages=disabled \
        -Ddocumentation=false \
        -Dtests=false
    install -Dm755 "$files/hook" "$pkg/usr/share/rpk/hooks/glib"
}
