version=2.5.24
release=1
description="GnuPG, gpg: what Flatpak checks repository signatures with"
depends="sys-libs/musl dev-libs/libgpg-error dev-libs/libassuan dev-libs/libgcrypt dev-libs/libksba dev-libs/npth sys-libs/zlib"
makedepends="dev-libs/libgpg-error dev-libs/libassuan dev-libs/libgcrypt dev-libs/libksba dev-libs/npth sys-libs/zlib"
dynamic=1
source="https://gnupg.org/ftp/gcrypt/gnupg/gnupg-$version.tar.bz2"
sha256=bf149d01a2b9fcc0e4589b8ae8697d3d5c557ea48ed95a3fa55dd3b1187e6039

# gpg and gpg-agent, for checking signatures. No smartcards, no keyserver
# access, no TOFU database. The GnuPG libraries find each other through
# gpgrt-config, not pkg-config, hence the prefixes
build() {
    ./configure --host="$TARGET" --prefix=/usr --sysconfdir=/etc \
        --with-libgpg-error-prefix="$stage/usr" \
        --with-libassuan-prefix="$stage/usr" \
        --with-libgcrypt-prefix="$stage/usr" \
        --with-ksba-prefix="$stage/usr" \
        --with-npth-prefix="$stage/usr" \
        --disable-scdaemon --disable-tpm2d --disable-keyboxd --disable-sqlite \
        --disable-tofu --disable-ldap --disable-gnutls --disable-ntbtls \
        --disable-wks-tools --disable-photo-viewers --disable-bzip2 \
        --without-readline --disable-doc --disable-nls
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
