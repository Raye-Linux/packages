version=16.6.0
release=1
description="GLSL to SPIR-V, Hyprland checks its shaders with it"
depends="sys-libs/musl sys-libs/gcc-libs"
dynamic=1
source="git+https://github.com/KhronosGroup/glslang#e1b562a8bed273a02f30b59b66a5d499793cede5"

build() {
    cmake_build -DBUILD_SHARED_LIBS=ON -DENABLE_OPT=OFF -DGLSLANG_TESTS=OFF \
        -DENABLE_GLSLANG_BINARIES=OFF -DBUILD_EXTERNAL=OFF
}
