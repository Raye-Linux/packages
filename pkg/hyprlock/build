version=0.9.6
release=1
description="Hyprland's screen locker"
depends="musl gcc-libs hyprlang hyprutils hyprgraphics sdbus-c++ linux-pam wayland libglvnd mesa libxkbcommon cairo pango libdrm"
makedepends="hyprlang hyprutils hyprgraphics sdbus-c++ linux-pam wayland wayland-protocols libglvnd mesa libxkbcommon cairo pango libdrm hyprwayland-scanner"
dynamic=1
source="git+https://github.com/hyprwm/hyprlock#b222d9b1f87e980cac379371df57913a53b99d7f"

# its PAM file includes "login", which busybox's login doesn't have;
# straight to pam_unix instead
build() {
    cmake_build
    printf 'auth required pam_unix.so\naccount required pam_unix.so\n' \
        > "$pkg/etc/pam.d/hyprlock"
}
