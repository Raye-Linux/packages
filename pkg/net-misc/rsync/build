version=3.5.1
release=1
description="fast file copying, locally or over ssh"
depends=""
source="https://download.samba.org/pub/rsync/src/rsync-$version.tar.gz"
sha256=c55f9c9dc10fb8bec397b399a0fdded53cc9a2d8e30891bb0d63724d25c37bef

build() {
    ./configure --prefix=/usr \
        --disable-openssl --disable-xxhash --disable-zstd --disable-lz4 \
        --disable-idn --with-included-zlib --with-included-popt \
        --disable-md2man
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
