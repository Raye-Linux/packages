version=1.11.0
release=2
description="mako, a small notification daemon"
depends="musl wayland cairo pango gdk-pixbuf basu"
makedepends="wayland wayland-protocols cairo pango gdk-pixbuf basu"
dynamic=1
source="git+https://github.com/emersion/mako#91c6b799855762ad1eb8b4498967c270a339be0c"

# standing in for swaync, which is blocked for now (see the notes on the
# hyprland branch of the live repo). Upstream only reads a config from
# your home; the patch adds /etc/xdg after it, where the desktop package
# keeps Raye's.
build() {
    patch -p1 < "$files/system-config.patch"
    meson_build -Dsd-bus-provider=basu -Dicons=enabled -Dman-pages=disabled \
        -Dfish-completions=false -Dzsh-completions=false -Dbash-completions=false
}
