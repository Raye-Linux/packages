version=8.3
release=1
description="line editing, for building against"
makedepends="ncurses"
source="https://ftp.gnu.org/gnu/readline/readline-$version.tar.gz"
sha256=fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc
buildonly=1

# static, with ncurses, which is static too. Whatever uses it gets both
# linked in and needs neither at runtime. PIC for the dynamic ones
build() {
    CFLAGS="-O2 -fPIC" ./configure --prefix=/usr --disable-shared --enable-static --with-curses
    make -j"$JOBS"
    make DESTDIR="$pkg" install
    # static, so whatever links it needs ncurses spelled out, not just
    # with --static. And tinfo is part of ncursesw here
    sed -i 's/^Requires.private: .*/Requires: ncursesw/' \
        "$pkg/usr/lib/pkgconfig/readline.pc"
}
