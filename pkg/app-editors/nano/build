version=9.3
release=1
description="the friendly text editor, with syntax colours on"
depends="sys-libs/terminfo"
makedepends="sys-libs/ncurses"
source="https://mirrors.kernel.org/gnu/nano/nano-$version.tar.xz"
sha256=a9affc52c9596ee0682bcdd4ceb3c0b235eb221d83d733dfd9b0dff45897cb0d

build() {
    ./configure --prefix=/usr --sysconfdir=/etc \
        --disable-nls --disable-libmagic --enable-utf8
    make -j"$JOBS"
    make DESTDIR="$pkg" install

    # highlighting for everything nano knows, out of the box
    install -Dm644 /dev/null "$pkg/etc/nanorc"
    echo 'include "/usr/share/nano/*.nanorc"' > "$pkg/etc/nanorc"
}
