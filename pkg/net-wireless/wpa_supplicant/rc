#!/bin/sh
#
# wpa_supplicant on every wireless interface, and dhcp on top of it once
# it's connected.
#
# The networks are in /etc/wpa_supplicant.conf. Add one with
#   wpa_passphrase "network name" "password" >> /etc/wpa_supplicant.conf
# or with wpa_cli while it runs (it saves what you add). The file isn't
# part of the package, so an upgrade never touches it.

conf=/etc/wpa_supplicant.conf
action=/usr/libexec/wpa_supplicant/dhcp

wireless() {
    for dev in /sys/class/net/*; do
        [ -d "$dev/wireless" ] && echo "${dev##*/}"
    done
}

case $1 in
    start)
        # wpa_cli needs these two at the top. A file that started with
        # wpa_passphrase >> doesn't have them
        if ! grep -q '^ctrl_interface=' "$conf" 2>/dev/null; then
            (
                umask 077
                printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=1\n\n' > "$conf.new"
                cat "$conf" >> "$conf.new" 2>/dev/null
                mv "$conf.new" "$conf"
            )
        fi
        for dev in $(wireless); do
            # the radio can be blocked: a Wi-Fi key, or a BIOS that turns
            # Wi-Fi off while a cable is plugged in. The link can't come up
            # then, and udhcpc on a link that's down never comes back, so
            # dhcp waits for wpa_cli to say we're connected instead.
            # wpa_supplicant brings the link up itself once it's unblocked
            ip link set "$dev" up 2>/dev/null ||
                echo "$dev: radio blocked (rfkill), it'll connect once it's unblocked"
            wpa_supplicant -B -s -i "$dev" -c "$conf" -P "/run/wpa_supplicant.$dev.pid"
            wpa_cli -B -i "$dev" -p /run/wpa_supplicant -a "$action" \
                -P "/run/wpa_cli.$dev.pid"
        done
        ;;
    stop)
        for dev in $(wireless); do
            for p in "/run/wpa_cli.$dev.pid" "/run/udhcpc.$dev.pid" \
                     "/run/wpa_supplicant.$dev.pid"; do
                [ -f "$p" ] && kill "$(cat "$p")" 2>/dev/null
            done
        done
        ;;
    *)
        echo "usage: $0 start|stop" >&2
        exit 1
        ;;
esac
