version=2.15.4
release=1
description="XML and HTML parsing"
depends="musl zlib"
makedepends="zlib"
dynamic=1
source="https://download.gnome.org/sources/libxml2/${version%.*}/libxml2-$version.tar.xz"
sha256=98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821

build() {
    meson_build -Dpython=disabled -Dicu=disabled -Dzlib=enabled \
        -Dreadline=disabled -Dhistory=disabled -Ddocs=disabled
}
