version=2026.1
release=1
description="X11 protocol headers, for building against"
source="https://www.x.org/releases/individual/proto/xorgproto-$version.tar.xz"
sha256=f9bfe4a9ed8c8ab9d2a3b0d49797f046052dadd06b7a8b45dbffaffb137e8290
buildonly=1

build() {
    meson setup _build --prefix=/usr -Dlegacy=false
    meson compile -C _build
    DESTDIR="$pkg" meson install -C _build --no-rebuild
}
