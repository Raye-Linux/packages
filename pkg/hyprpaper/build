description="wallpapers for Hyprland"
depends="musl gcc-libs hyprlang hyprutils hyprtoolkit hyprwire pixman libdrm wayland"
makedepends="hyprlang hyprutils hyprtoolkit hyprwire pixman libdrm wayland wayland-protocols hyprwayland-scanner"
dynamic=1
source="git+https://github.com/hyprwm/hyprpaper#20fc0fa6c2056c388a4cd69cb394a9f989dd27c0"

# leans on glibc's headers bringing <cstring> in for strncpy
build() {
    sed -i '1i #include <cstring>' src/ipc/HyprlandSocket.cpp
    cmake_build
}
