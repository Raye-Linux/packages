version=2.3.2
release=1
description="directory listings as a tree"
depends=""
source="https://gitlab.com/OldManProgrammer/unix-tree/-/archive/$version/unix-tree-$version.tar.gz"
sha256=513a53cbc42ca1f4ea06af2bab1f5283524a3848266b1d162416f8033afc4985

build() {
    make -j"$JOBS" CC="$CC" CFLAGS="-O2 -Wall" LDFLAGS="$LDFLAGS"
    install -Dm755 tree "$pkg/usr/bin/tree"
}
