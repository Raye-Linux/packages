version=3.8
release=1
description="terminal multiplexer: panes, windows, sessions that survive"
depends="terminfo"
makedepends="ncurses libevent"
source="https://github.com/tmux/tmux/releases/download/$version/tmux-$version.tar.gz"
sha256=e79c699c7e949dccd0a4a125e17b8d1261e311b16979dbc8eb34542f3966d82e

build() {
    ./configure --prefix=/usr --enable-static
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
