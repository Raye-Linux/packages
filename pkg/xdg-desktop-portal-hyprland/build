version=1.4.1
release=1
description="Hyprland's portal backend: screenshots and screen sharing"
depends="musl gcc-libs xdg-desktop-portal slurp sdbus-c++ pipewire libdrm mesa wayland hyprlang hyprutils"
makedepends="sdbus-c++ pipewire libdrm mesa wayland wayland-protocols hyprlang hyprutils hyprwayland-scanner hyprland-protocols util-linux"
dynamic=1
source="git+https://github.com/hyprwm/xdg-desktop-portal-hyprland#cc8e5ef8fb2acef3db488b9a33b0c48c2a4ee204"

# The real hyprland-share-picker is Qt6, all of it for one dialog. A
# small script by the same name stands in, with slurp: it shares whole
# outputs, windows and regions need the real one
build() {
    sed -i -e '/add_subdirectory(hyprland-share-picker)/d' \
        -e '/install(TARGETS hyprland-share-picker)/d' CMakeLists.txt
    cmake_build
    install -Dm755 "$files/picker" "$pkg/usr/bin/hyprland-share-picker"
}
