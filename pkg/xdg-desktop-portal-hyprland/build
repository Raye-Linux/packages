version=1.4.1
release=1
description="Hyprland's portal backend: screenshots and screen sharing"
depends="musl gcc-libs xdg-desktop-portal sdbus-c++ pipewire libdrm mesa wayland hyprlang hyprutils"
makedepends="sdbus-c++ pipewire libdrm mesa wayland wayland-protocols hyprlang hyprutils hyprwayland-scanner util-linux"
dynamic=1
source="git+https://github.com/hyprwm/xdg-desktop-portal-hyprland#cc8e5ef8fb2acef3db488b9a33b0c48c2a4ee204"

# Without hyprland-share-picker: it's Qt6, all of it for one dialog.
# screencopy:custom_picker_binary in the portal's config points it at
# something else that picks an output or a window
build() {
    sed -i -e '/add_subdirectory(hyprland-share-picker)/d' \
        -e '/install(TARGETS hyprland-share-picker)/d' CMakeLists.txt
    cmake_build
}
