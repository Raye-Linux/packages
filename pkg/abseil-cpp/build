version=20260817.0
release=1
description="Google's C++ base library, for re2"
depends="musl gcc-libs"
dynamic=1
source="git+https://github.com/abseil/abseil-cpp#2065f4ded0558c6f89fee67c8e5228feb4eb960e"

build() {
    cmake_build -DBUILD_SHARED_LIBS=ON -DABSL_BUILD_TESTING=OFF \
        -DCMAKE_CXX_STANDARD=17 -DABSL_PROPAGATE_CXX_STD=ON
}
