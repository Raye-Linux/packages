version=2.9.0
release=1
description="XML parser, for wayland and fontconfig"
depends="musl"
dynamic=1
source="https://github.com/libexpat/libexpat/releases/download/R_$(echo $version | tr . _)/expat-$version.tar.xz"
sha256=1e6371862cc31999b368c3b89b49994f0677e1bab5f1b2b85ae3741f5d803051

build() {
    ./configure --host="$TARGET" --prefix=/usr --disable-static \
        --without-docbook --without-examples --without-tests
    make -j"$JOBS"
    make DESTDIR="$pkg" install
    rm -f "$pkg/usr/bin/xmlwf"
}
