version=2.90.1
release=1
description="the introspection data of GLib, GObject and Gio"
makedepends="glib gobject-introspection libffi pcre2 zlib"
dynamic=1
buildonly=1
source="https://download.gnome.org/sources/glib/${version%.*}/glib-$version.tar.xz"
sha256=93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396

# GLib makes its .gir files itself, but it needs gobject-introspection
# for that, which needs GLib. So the glib package goes without, and this
# builds the same version a second time with it, keeping only the .gir
# files. Keep the version in step with glib's.
build() {
    meson setup _build --cross-file "$MESON_CROSS" \
        --native-file "$work/meson.native" \
        -Dintrospection=enabled -Dnls=disabled -Dlibmount=disabled \
        -Dselinux=disabled -Dsysprof=disabled -Dlibelf=disabled \
        -Dman-pages=disabled -Ddocumentation=false -Dtests=false
    meson compile -C _build -j "$JOBS"
    DESTDIR="$PWD/_inst" meson install -C _build --no-rebuild
    mkdir -p "$pkg/usr/share"
    cp -a _inst/usr/share/gir-1.0 "$pkg/usr/share/"
}
