version=2.103.2
release=1
description="GitHub from the command line"
depends="ca-certificates"
source="https://github.com/cli/cli/archive/refs/tags/v$version.tar.gz"
sha256=73a62f89937b2c058e0873a571f4963a28c7c78d3b60d0bf29e5658789eb8012

# Go without cgo makes a static binary that doesn't care which libc is
# around. Needs go on the build machine; GOTOOLCHAIN=auto fetches the
# version gh asks for if the installed one is too old.
build() {
    export CGO_ENABLED=0 GOTOOLCHAIN=auto GOFLAGS=-trimpath
    go build \
        -ldflags "-s -w -X github.com/cli/cli/v2/internal/build.Version=$version" \
        -o "$pkg/usr/bin/gh" ./cmd/gh
}
