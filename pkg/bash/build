version=5.3
release=1
description="the GNU shell, for scripts that want #!/bin/bash"
depends="terminfo"
makedepends="ncurses"
source="https://mirrors.kernel.org/gnu/bash/bash-$version.tar.gz"
sha256=0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba

# bindir /bin so #!/bin/bash scripts work. musl has its own malloc, the
# one bash bundles doesn't get along with it.
build() {
    ./configure --prefix=/usr --bindir=/bin \
        --without-bash-malloc --enable-static-link --disable-nls
    make -j"$JOBS"
    make DESTDIR="$pkg" install
    rm -rf "$pkg/usr/lib/bash" "$pkg/usr/share/locale" "$pkg/bin/bashbug"
}
