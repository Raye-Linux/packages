version=1.18.4
release=2
description="Flatpak: sandboxed desktop apps, from Flathub and the like"
depends="sys-libs/musl dev-libs/glib dev-util/ostree net-misc/curl app-arch/libarchive dev-libs/libxml2 dev-libs/json-glib dev-libs/appstream x11-libs/gdk-pixbuf app-crypt/gpgme sys-libs/libseccomp sys-libs/libcap app-arch/zstd sys-fs/fuse3 sys-apps/bubblewrap sys-apps/xdg-dbus-proxy dev-libs/wayland app-misc/ca-certificates"
makedepends="dev-libs/glib dev-util/ostree net-misc/curl app-arch/libarchive dev-libs/libxml2 dev-libs/json-glib dev-libs/appstream x11-libs/gdk-pixbuf app-crypt/gpgme dev-libs/libgpg-error sys-libs/libseccomp sys-libs/libcap app-arch/zstd sys-fs/fuse3 dev-libs/wayland dev-libs/wayland-protocols"
dynamic=1
source="https://github.com/flatpak/flatpak/releases/download/$version/flatpak-$version.tar.xz"
sha256=b899a7a00c48d2c626cb8ec33fe556720b376c25805d7222430c0fdca4c6ac8d

# per-user installs only (flatpak --user): system-wide ones go through a
# helper that wants polkit. bubblewrap and xdg-dbus-proxy are the
# packaged ones rather than the copies Flatpak would build itself
build() {
    # it runs bwrap and xdg-dbus-proxy --version to check them, the
    # staged ones on the PATH answer
    meson_build \
        -Dsystem_helper=disabled \
        -Dsystemd=disabled \
        -Ddconf=disabled \
        -Dmalcontent=disabled \
        -Dselinux_module=disabled \
        -Dxauth=disabled \
        -Dwayland_security_context=enabled \
        -Dsystem_bubblewrap=bwrap \
        -Dsystem_dbus_proxy=xdg-dbus-proxy \
        -Dsystem_fusermount=/usr/bin/fusermount3 \
        -Dlibzstd=enabled \
        -Dseccomp=enabled \
        -Dgir=disabled \
        -Dgtkdoc=disabled \
        -Ddocbook_docs=disabled \
        -Dman=disabled \
        -Dtests=false \
        -Dinstalled_tests=false
}
