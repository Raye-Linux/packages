version=3.8.10
release=1
description="reads and writes most archive formats, for Flatpak"
depends="sys-libs/musl sys-libs/zlib app-arch/zstd"
makedepends="sys-libs/zlib app-arch/zstd"
dynamic=1
source="https://github.com/libarchive/libarchive/releases/download/v$version/libarchive-$version.tar.xz"
sha256=56cad765459d5ee25a3b761f90c47d99379d28297fbfb72d908880d6b875fb96

# gzip and zstd, which is what Flatpak meets. The command line tools are
# busybox's job
build() {
    ./configure --host="$TARGET" --prefix=/usr --disable-static \
        --disable-bsdtar --disable-bsdcpio --disable-bsdcat --disable-bsdunzip \
        --with-zlib --with-zstd --without-lzma --without-bz2lib --without-lz4 \
        --without-xml2 --without-expat --without-openssl --without-nettle \
        --without-mbedtls --without-libb2 --disable-acl --disable-xattr
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
