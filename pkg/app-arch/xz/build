version=5.8.4
release=2
description="liblzma, and the xz command"
depends="sys-libs/musl"
dynamic=1
source="https://github.com/tukaani-project/xz/releases/download/v$version/xz-$version.tar.xz"
sha256=4ce24038fd4221e0d13bc1a2de7a4db56e90b92b3bf75321f6c14be73f65de4b

# busybox only unpacks xz, and building packages (mkrepo, on raye too)
# has to make them. The xz command takes over from busybox's links
build() {
    ./configure --host="$TARGET" --prefix=/usr --disable-static --disable-doc \
        --disable-nls --disable-xzdec --disable-lzmadec --disable-lzmainfo \
        --disable-scripts --disable-lzma-links
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
