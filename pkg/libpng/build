version=1.6.59
release=1
description="PNG images"
depends="musl zlib"
makedepends="zlib"
dynamic=1
source="https://download.sourceforge.net/libpng/libpng-$version.tar.xz"
sha256=d80dd2a38a37f803cb9b6ac7b14bd6e74ddc3b654780a8380bdf93523fdb4389

build() {
    ./configure --host="$TARGET" --prefix=/usr --disable-static --disable-tools
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
