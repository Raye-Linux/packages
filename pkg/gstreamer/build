version=1.28.8
release=1
description="GStreamer's core, for xdg-desktop-portal"
depends="musl glib"
makedepends="glib"
dynamic=1
source="https://gstreamer.freedesktop.org/src/gstreamer/gstreamer-$version.tar.xz"
sha256=baa8e86985ad6417cc0ad6e7b79ff2884c6779c8b1c7a6240e7121822c86e524

# the portal only links its utility library; playing media is up to the
# apps (Flatpak ones bring their own)
build() {
    meson_build -Dauto_features=disabled -Dexamples=disabled -Dtests=disabled \
        -Dbenchmarks=disabled -Ddoc=disabled -Dtools=disabled
}
