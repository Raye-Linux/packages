version=1.4.1
release=1
description="complex numbers on top of mpfr, for gcc"
makedepends="dev-libs/gmp dev-libs/mpfr"
buildonly=1
source="https://ftp.gnu.org/gnu/mpc/mpc-$version.tar.xz"
sha256=91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931

build() {
    ./configure --host="$TARGET" --prefix=/usr --disable-shared --enable-static \
        --with-gmp="$stage/usr" --with-mpfr="$stage/usr"
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
