version=1.8
release=1
description="GnuPG's threads library"
depends="sys-libs/musl"
dynamic=1
source="https://gnupg.org/ftp/gcrypt/npth/npth-$version.tar.bz2"
sha256=8bd24b4f23a3065d6e5b26e98aba9ce783ea4fd781069c1b35d149694e90ca3e

build() {
    # gnupg still looks for npth-config
    ./configure --host="$TARGET" --prefix=/usr --disable-static --disable-doc \
        --enable-install-npth-config
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
