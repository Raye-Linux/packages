version=1.86.0
release=1
description="GObject introspection data, for the Vala bindings of the GTK 4 stack"
makedepends="dev-libs/glib dev-libs/libffi x11-libs/cairo"
dynamic=1
buildonly=1
source="https://download.gnome.org/sources/gobject-introspection/${version%.*}/gobject-introspection-$version.tar.xz"
sha256=920d1a3fcedeadc32acff95c2e203b319039dd4b4a08dd1a2dfd283d19c0b9ae

# Nothing on raye reads typelibs, so none of this gets packaged. What
# it's for is the .gir files: the Vala bindings of libadwaita and
# gtk4-layer-shell are generated from them, and swaync is written in
# Vala.
#
# g-ir-scanner is a Python program that compiles a small program
# against the library it looks at and runs it, to ask GObject what the
# types are. So it has to run here, on the build machine, while the
# program it runs is a musl one. It's built natively (against a native
# GLib as new as raye's, the build machine's is older than gi wants),
# lives in $work/native, and every recipe gets it through a wrapper in
# the stage that runs those programs through the musl loader.
build() {
    native=$work/native
    # an rpath rather than LD_LIBRARY_PATH: the scanner runs musl programs,
    # and musl's loader would look there too
    host="env -u CPPFLAGS -u PKG_CONFIG_LIBDIR -u PKG_CONFIG_SYSROOT_DIR CC=gcc CXX=g++ LDFLAGS=-Wl,-rpath,$native/lib"

    # glib's own tarball, already fetched and checked for the glib recipe
    glib=$(. "$top/pkg/dev-libs/glib/build"; echo "$version $sha256")
    gsrc=$work/src/dev-libs/glib/glib-${glib% *}.tar.xz
    echo "${glib#* }  $gsrc" | sha256sum -c --status - || exit 1
    mkdir -p _glib
    tar -xf "$gsrc" -C _glib --strip-components=1
    (
        cd _glib
        $host meson setup _native --prefix="$native" --libdir=lib \
            -Dintrospection=disabled -Dnls=disabled -Dlibmount=disabled \
            -Dselinux=disabled -Dsysprof=disabled -Dlibelf=disabled \
            -Dman-pages=disabled -Ddocumentation=false -Dtests=false
        ninja -C _native install
    )

    $host PKG_CONFIG_PATH="$native/lib/pkgconfig" \
        meson setup _native --prefix="$native" --libdir=lib \
        -Dcairo=disabled -Ddoctool=disabled -Dbuild_introspection_data=false \
        -Dtests=false
    ninja -C _native install

    # What the scanner calls: gi-run to run a musl program, gi-ldd to
    # ask which libraries it loads (musl's loader with --list), gi-cc to
    # compile one. The scanner points LD_LIBRARY_PATH at the musl
    # libraries it means for that program, and anything on the build
    # machine that saw them (readelf, the linker) would load them too. So
    # each of these moves them over to RUN_LIBS, which only the musl
    # loader gets to see.
    prelude='RUN_LIBS="${LD_LIBRARY_PATH}${RUN_LIBS:+:$RUN_LIBS}"; unset LD_LIBRARY_PATH'
    sed "1a $prelude" "$RUN" > "$native/bin/gi-run"
    sed -e "1a $prelude" -e 's/ --library-path / --list --library-path /' \
        "$RUN" > "$native/bin/gi-ldd"
    printf '#!/bin/sh\nexec env -u LD_LIBRARY_PATH $GI_CC "$@"\n' > "$native/bin/gi-cc"
    chmod +x "$native"/bin/gi-*

    # the target's libgirepository and its .pc, with the native tools
    # standing in for the ones it would build. The scanner's Python half
    # isn't needed for raye at all, and wants a Python to build against
    sed -i -e "/^cc.check_header('Python.h'/d" -e "/^subdir('giscanner')/d" meson.build
    PATH="$native/bin:$PATH" meson_build -Dgi_cross_use_prebuilt_gi=true \
        -Dgi_cross_binary_wrapper="$native/bin/gi-run" \
        -Dgi_cross_ldd_wrapper="$native/bin/gi-ldd" \
        -Dgi_cross_pkgconfig_sysroot_path="$stage" \
        -Dbuild_introspection_data=false -Ddoctool=disabled -Dtests=false

    # the .gir files gi ships for libraries that don't make their own
    # (cairo, freetype, fontconfig...). Written by hand, so they're only
    # copied; cairo's gets the name of its library filled in
    g=$pkg/usr/share/gir-1.0
    mkdir -p "$g"
    cp gir/*.gir "$g/"
    sed -e 's/@CAIRO_SHARED_LIBRARY@/libcairo-gobject.so.2/' \
        -e 's/@CAIRO_GIR_PACKAGE@/cairo-gobject/' gir/cairo-1.0.gir.in > "$g/cairo-1.0.gir"

    # what gnome.generate_gir finds through the .pc: the native scanner,
    # with the helpers above. Meson hands it LD_LIBRARY_PATH too, the
    # libraries it just built, which the native Python mustn't load, and
    # --lib-dirs-envvar keeps the scanner from setting it again for the
    # rest of what it runs (the Python filters some projects use)
    rm -f "$pkg"/usr/bin/g-ir-*
    mkdir -p "$pkg/usr/bin"
    cat > "$pkg/usr/bin/g-ir-scanner" <<EOF
#!/bin/sh
$prelude
GI_CC=\${CC:-cc}
export RUN_LIBS GI_CC CC="$native/bin/gi-cc"
exec "$native/bin/g-ir-scanner" \\
    --use-binary-wrapper="$native/bin/gi-run" --use-ldd-wrapper="$native/bin/gi-ldd" \\
    --lib-dirs-envvar=RUN_LIBS "\$@"
EOF
    for t in g-ir-compiler g-ir-generate; do
        printf '#!/bin/sh\nexec "%s" "$@"\n' "$native/bin/$t" > "$pkg/usr/bin/$t"
    done
    chmod +x "$pkg"/usr/bin/g-ir-*
}
