version=4.2.2
release=1
description="floating point with exact rounding, for gcc"
makedepends="dev-libs/gmp"
buildonly=1
source="https://ftp.gnu.org/gnu/mpfr/mpfr-$version.tar.xz"
sha256=b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01

build() {
    ./configure --host="$TARGET" --prefix=/usr --disable-shared --enable-static \
        --with-gmp="$stage/usr"
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
