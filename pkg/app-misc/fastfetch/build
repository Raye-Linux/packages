version=2.70.0
release=1
description="system info, with the raye eye"
depends=""
source="https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/$version.tar.gz"
sha256=8aa01bd3faff2be1d94f231d76489ce6d9f781f51f6e93eafe82359d6d8669af

# Plain upstream fastfetch. The logo and the defaults are separate files
# (raye.txt, config.jsonc), so bumping the version never touches them.
#
# fastfetch dlopen()s its optional libraries (vulkan, wayland, dbus...),
# which a static binary can't do anyway, so they're all switched off
# and pkg-config is kept from finding the build host's copies.
optional="VULKAN WAYLAND XCB_RANDR XRANDR DRM DRM_AMDGPU GIO DCONF DBUS
SQLITE3 RPM IMAGEMAGICK7 IMAGEMAGICK6 CHAFA ZLIB EGL GLX OPENCL FREETYPE
PULSE DDCUTIL ELF LIBZFS"

build() {
    off=
    for f in $optional; do
        off="$off -DENABLE_$f=OFF"
    done

    # shellcheck disable=SC2086
    PKG_CONFIG_LIBDIR=/nonexistent cmake -S . -B _build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_EXE_LINKER_FLAGS=-static \
        -DIS_MUSL=ON \
        -DBUILD_FLASHFETCH=OFF \
        -DBUILD_TESTS=OFF \
        -DENABLE_SYSTEM_YYJSON=OFF \
        $off

    cmake --build _build -j"$JOBS"
    DESTDIR="$pkg" cmake --install _build

    rm -rf "$pkg/usr/share/bash-completion" "$pkg/usr/share/zsh" \
           "$pkg/usr/share/fish" "$pkg/usr/share/licenses"
    install -Dm644 "$files/raye.txt" "$pkg/usr/share/fastfetch/logos/raye.txt"
    install -Dm644 "$files/config.jsonc" "$pkg/etc/xdg/fastfetch/config.jsonc"
}
