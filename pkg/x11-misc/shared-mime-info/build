version=2.5.1
release=1
description="the MIME type database: what a file is, by name and content"
depends="sys-libs/musl sys-libs/gcc-libs dev-libs/glib dev-libs/libxml2"
makedepends="dev-libs/glib dev-libs/libxml2"
dynamic=1
source="git+https://gitlab.freedesktop.org/xdg/shared-mime-info.git#fd8ab89c20093f1bfba8fa9e302ba584fffd0fd7"

# the database gets compiled here, so it's there from the first boot
build() {
    meson_build -Dupdate-mimedb=false -Dbuild-tools=true -Dbuild-translations=false \
        -Dbuild-tests=false -Dbuild-spec=false
    "$RUN" _build/src/update-mime-database "$pkg/usr/share/mime"
    install -Dm755 "$files/hook" "$pkg/usr/share/rpk/hooks/shared-mime-info"
}
