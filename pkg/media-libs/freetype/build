version=2.15.0
release=1
description="font rendering"
depends="sys-libs/musl sys-libs/zlib media-libs/libpng"
makedepends="sys-libs/zlib media-libs/libpng"
dynamic=1
source="https://download.savannah.gnu.org/releases/freetype/freetype-$version.tar.xz"
sha256=93cd47eb719c325107f2d3cf087d06299e944c3b48a40b55537302304dea1dd5

# harfbuzz builds against freetype, so freetype goes without it rather
# than the two chasing each other
build() {
    meson_build \
        -Dharfbuzz=disabled \
        -Dbrotli=disabled \
        -Dbzip2=disabled \
        -Dpng=enabled \
        -Dzlib=system
}
