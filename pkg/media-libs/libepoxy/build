version=1.5.10
release=1
description="finds the GL functions at runtime, GTK draws through it"
depends="sys-libs/musl media-libs/libglvnd"
makedepends="media-libs/libglvnd"
dynamic=1
source="https://download.gnome.org/sources/libepoxy/${version%.*}/libepoxy-$version.tar.xz"
sha256=072cda4b59dd098bba8c2363a6247299db1fa89411dc221c8b81b8ee8192e623

build() {
    meson_build -Dglx=no -Degl=yes -Dx11=false -Dtests=false -Ddocs=false
}
