version=15.0.0
release=1
description="text shaping"
depends="sys-libs/musl sys-libs/gcc-libs media-libs/freetype dev-libs/glib"
makedepends="media-libs/freetype dev-libs/glib"
dynamic=1
source="https://github.com/harfbuzz/harfbuzz/releases/download/$version/harfbuzz-$version.tar.xz"
