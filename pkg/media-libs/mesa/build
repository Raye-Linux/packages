version=26.2.5
release=1
description="OpenGL, GLES and EGL: Intel's iris, and softpipe for everything else"
depends="sys-libs/musl sys-libs/gcc-libs media-libs/libglvnd x11-libs/libdrm dev-libs/expat sys-libs/zlib dev-libs/wayland"
makedepends="media-libs/libglvnd x11-libs/libdrm dev-libs/expat sys-libs/zlib dev-libs/wayland dev-libs/wayland-protocols"
dynamic=1
source="https://archive.mesa3d.org/mesa-$version.tar.xz"
sha256=794b3d1729075dae7ebd47c7283b7ca0cdb5dec668f7f11cc0a5d82f6138a0a5

# No LLVM on raye. iris still needs mesa_clc at build time to compile
# its built-in shaders, and mesa_clc is built on LLVM, so a native one
# gets built first against the build machine's LLVM (llvm-19-dev,
# libclang-cpp19-dev, libllvmspirvlib-19-dev, spirv-tools). It only runs
# here; nothing from it ends up in the package.
build() {
    printf "[binaries]\nllvm-config = 'llvm-config-19'\n" > clc-native.ini
    env -u CPPFLAGS -u LDFLAGS -u PKG_CONFIG_LIBDIR -u PKG_CONFIG_SYSROOT_DIR \
        CC=gcc CXX=g++ meson setup _clc --native-file clc-native.ini \
        -Dgallium-drivers= -Dvulkan-drivers= -Dplatforms= \
        -Dglx=disabled -Degl=disabled -Dgbm=disabled -Dopengl=false \
        -Dgles1=disabled -Dgles2=disabled \
        -Dmesa-clc=enabled -Dinstall-mesa-clc=true \
        -Dllvm=enabled -Dshared-llvm=enabled \
        -Dvalgrind=disabled -Dlibunwind=disabled -Dzstd=disabled \
        -Dxmlconfig=disabled -Dbuild-tests=false
    ninja -C _clc src/compiler/clc/mesa_clc src/compiler/spirv/vtn_bindgen2
    printf "[binaries]\nmesa_clc = '%s'\nvtn_bindgen2 = '%s'\n" \
        "$PWD/_clc/src/compiler/clc/mesa_clc" \
        "$PWD/_clc/src/compiler/spirv/vtn_bindgen2" > clc.ini

    meson_build --native-file clc.ini \
        -Dplatforms=wayland \
        -Dgallium-drivers=iris,softpipe \
        -Dvulkan-drivers= \
        -Degl=enabled \
        -Dgbm=enabled \
        -Dgles1=disabled \
        -Dgles2=enabled \
        -Dopengl=true \
        -Dglx=disabled \
        -Dglvnd=enabled \
        -Dllvm=disabled \
        -Dmesa-clc=system \
        -Dintel-rt=disabled \
        -Dgallium-va=disabled \
        -Dgallium-rusticl=false \
        -Dmicrosoft-clc=disabled \
        -Dvideo-codecs= \
        -Dvalgrind=disabled \
        -Dlibunwind=disabled \
        -Dlmsensors=disabled \
        -Dzstd=disabled \
        -Dxlib-lease=disabled \
        -Dbuild-tests=false
}
