version=1.4.0
release=1
description="screenshots on wayland"
depends="musl wayland pixman libpng libjpeg-turbo"
makedepends="wayland wayland-protocols pixman libpng libjpeg-turbo"
dynamic=1
source="git+https://github.com/emersion/grim#e2cb2d12790fb4d5e91ddc20c3dbe896b00f70ee"

build() {
    meson_build -Djpeg=enabled -Dman-pages=disabled \
        -Dbash-completions=false -Dfish-completions=false
}
