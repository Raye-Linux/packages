version=0.3.29
release=1
description="fast queryable XML blobs, for appstream"
depends="musl glib zstd"
makedepends="glib zstd"
dynamic=1
source="https://github.com/hughsie/libxmlb/releases/download/$version/libxmlb-$version.tar.xz"
sha256=448294be33bfae62f00fa66e506f1cae80237ce71b7ab6530aefa75005eeb08a

build() {
    meson_build -Dgtkdoc=false -Dintrospection=false -Dtests=false -Dcli=false \
        -Dlzma=disabled -Dzstd=enabled -Dstemmer=false
}
