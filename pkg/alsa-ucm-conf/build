version=1.2.16.1
release=1
description="ALSA use case profiles: how a sound card's pieces fit together"
depends=""
source="https://www.alsa-project.org/files/pub/lib/alsa-ucm-conf-$version.tar.bz2"
sha256=cf3d1c07e089a83c4ece2c20f05dd6a8aab7fcd108768c38811386880575492b

# SOF cards (Tiger Lake and later laptops) only show proper outputs and
# inputs through these
build() {
    install -d "$pkg/usr/share/alsa"
    cp -R ucm ucm2 "$pkg/usr/share/alsa/"
}
