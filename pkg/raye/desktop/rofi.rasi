/* Raye's launcher. Settings in ~/.config/rofi/config.rasi go on top of
 * these, so a @theme of your own replaces the look entirely. */

configuration {
    modi: "drun,run";
    show-icons: true;
    drun-display-format: "{name}";
    font: "DejaVu Sans 12";
}

* {
    bg: #0e0a16;
    bg-alt: #1a1326;
    fg: #f3eaff;
    dim: #8a7fa0;
    accent: #b46cff;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 560px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 6px;
}

mainbox {
    padding: 12px;
    spacing: 10px;
}

inputbar {
    padding: 8px 10px;
    background-color: @bg-alt;
    border-radius: 4px;
    children: [ prompt, entry ];
    spacing: 8px;
}

prompt {
    text-color: @accent;
}

listview {
    lines: 8;
    spacing: 2px;
}

element {
    padding: 6px 10px;
    border-radius: 4px;
    spacing: 8px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-text {
    text-color: inherit;
}

element-icon {
    size: 20px;
}
