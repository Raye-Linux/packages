version=1.2.1
release=1
description="app metadata, what Flatpak shows about the apps it installs"
depends="musl glib curl libxml2 libfyaml libxmlb zstd"
makedepends="glib curl libxml2 libfyaml libxmlb zstd"
dynamic=1
source="https://www.freedesktop.org/software/appstream/releases/AppStream-$version.tar.xz"
sha256=7df664fd3ad3b1640c6a0ff77fa84f9fabe264111bf1fe8f5df3444d6d4caaca

# A cross build wants a native appstreamcli, only to write appstream's
# own metainfo file. data/ without that part
build() {
    cat > data/meson.build <<'EOF'
install_data('its/metainfo.its', 'its/metainfo.loc',
             install_dir: join_paths(get_option('datadir'), 'gettext', 'its'))
install_data('appstream.conf', install_dir: as_data_installdir)
EOF
    meson_build \
        -Dstemming=false -Dsystemd=false -Dvapi=false -Dqt=false \
        -Dcompose=false -Dapt-support=false -Dgir=false -Dtools=false \
        -Dzstd-support=true -Ddisplay-detection=none -Dbash-completion=false \
        -Ddocs=false -Dapidocs=false -Dinstall-docs=false -Dman=false
}
