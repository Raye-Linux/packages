version=2.48
release=1
description="keyboard layouts"
depends=""
source="https://www.x.org/releases/individual/data/xkeyboard-config/xkeyboard-config-$version.tar.xz"
sha256=b77041324f0109f77161ee43743fe04baa485866af8460d31e476ad3f7648fd5

build() {
    meson setup _build --prefix=/usr -Dxorg-rules-symlinks=false -Dnls=false
    meson compile -C _build
    DESTDIR="$pkg" meson install -C _build --no-rebuild
}
