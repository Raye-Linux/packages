version=1.6.10
release=1
description="PipeWire: sound for everything, and what Pulse and ALSA programs get"
depends="sys-libs/musl media-libs/alsa-lib media-libs/alsa-ucm-conf sys-apps/dbus sys-fs/eudev dev-libs/glib"
makedepends="media-libs/alsa-lib sys-apps/dbus sys-fs/eudev dev-libs/glib sys-libs/ncurses"
dynamic=1
source="git+https://gitlab.freedesktop.org/pipewire/pipewire.git#f9d6cbc99c354b9b0ad1d37245dc3ab0fb9f9171"

# Sound only: no bluetooth, cameras, JACK or network audio. The Pulse
# server (pipewire-pulse) is in, it's what Flatpak apps play through,
# and so is the ALSA plugin for the programs that talk to ALSA directly.
# WirePlumber is the session manager, it's its own package.
build() {
    meson_build \
        -Dsession-managers=[] \
        -Dalsa=enabled -Dpipewire-alsa=enabled \
        -Ddbus=enabled -Dudev=enabled -Dflatpak=enabled \
        -Dbluez5=disabled -Djack=disabled -Dpipewire-jack=disabled \
        -Djack-devel=false -Dv4l2=disabled -Dpipewire-v4l2=disabled \
        -Dlibcamera=disabled -Dvulkan=disabled -Dffmpeg=disabled \
        -Dgstreamer=disabled -Dgstreamer-device-provider=disabled \
        -Dlibsystemd=disabled -Dlogind=disabled \
        -Dsystemd-system-service=disabled -Dsystemd-user-service=disabled \
        -Dselinux=disabled -Dpw-cat=disabled -Dsndfile=disabled \
        -Dsdl2=disabled -Dlibmysofa=disabled -Dlibpulse=disabled \
        -Droc=disabled -Davahi=disabled -Decho-cancel-webrtc=disabled \
        -Dlibusb=disabled -Draop=disabled -Dlv2=disabled -Dx11=disabled \
        -Dx11-xfixes=disabled -Dlibcanberra=disabled -Davb=disabled \
        -Dreadline=disabled -Dgsettings=disabled -Dcompress-offload=disabled \
        -Dsnap=disabled -Dopus=disabled -Debur128=disabled -Dfftw=disabled \
        -Donnxruntime=disabled -Dlibffado=disabled \
        -Dlegacy-rtkit=false -Dpam-defaults-install=false -Drlimits-install=false \
        -Dexamples=disabled -Dtests=disabled -Dinstalled_tests=disabled \
        -Ddocs=disabled -Dman=disabled
}
