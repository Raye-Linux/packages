version=0.13.1
release=1
description="the sandbox Flatpak runs apps in"
depends="musl libcap"
makedepends="libcap"
dynamic=1
source="https://github.com/containers/bubblewrap/releases/download/v$version/bubblewrap-$version.tar.xz"
sha256=0e85c8702248b8dd64144f594147553650cdd0e4c951690345faace79c217c4d

# not setuid: the kernel has user namespaces, bwrap uses those
build() {
    meson_build -Dselinux=disabled -Dman=disabled -Dtests=false \
        -Dbash_completion=disabled -Dzsh_completion=disabled
}
