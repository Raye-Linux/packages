version=3.2.15
release=1
description="udev: device events, names and permissions"
depends="sys-libs/musl"
dynamic=1
source="https://github.com/eudev-project/eudev/releases/download/v$version/eudev-$version.tar.gz"
sha256=eb69809fc0d1187f2463ab2149c53aa9f42a78e59f14ebea68eae6cb6b4fc1c3

# no modules on raye, so no kmod; blkid comes from busybox
build() {
    ./configure --host="$TARGET" \
        --prefix=/usr \
        --sysconfdir=/etc \
        --sbindir=/usr/sbin \
        --libdir=/usr/lib \
        --with-rootprefix=/usr \
        --with-rootlibdir=/usr/lib \
        --disable-static \
        --disable-kmod \
        --disable-blkid \
        --disable-selinux \
        --disable-manpages
    make -j"$JOBS"
    make DESTDIR="$pkg" install
    install -Dm755 "$files/rc" "$pkg/etc/rc.d/udev"
}
