version=1.15.3
release=1
description="the GTK portal backend: file chooser, app chooser, settings"
depends="musl gtk3 glib gsettings-desktop-schemas xdg-desktop-portal fontconfig"
makedepends="gtk3 glib gsettings-desktop-schemas xdg-desktop-portal fontconfig"
dynamic=1
source="https://github.com/flatpak/xdg-desktop-portal-gtk/releases/download/$version/xdg-desktop-portal-gtk-$version.tar.xz"
sha256=47a3743d2419a8601e691db37e85bb5fac5ae4b26842177065cd5f22ada23b37

# the wallpaper portal wants gnome-desktop, Hyprland has its own anyway
build() {
    meson_build -Dwallpaper=disabled -Dsettings=enabled -Dappchooser=enabled \
        -Dlockdown=disabled
}
