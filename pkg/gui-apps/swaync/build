version=0.12.6
release=1
description="swaync, a notification daemon with a control centre"
depends="sys-libs/musl dev-libs/glib gui-libs/gtk4 gui-libs/gtk4-layer-shell gui-libs/libadwaita dev-libs/granite dev-libs/libgee dev-libs/json-glib dev-libs/wayland"
makedepends="dev-libs/glib gui-libs/gtk4 gui-libs/gtk4-layer-shell gui-libs/libadwaita dev-libs/granite dev-libs/libgee dev-libs/json-glib dev-libs/wayland dev-libs/wayland-protocols dev-lang/vala"
dynamic=1
source="git+https://github.com/ErikReider/SwayNotificationCenter#1043ef98ec97a27e24192a726576fce807d2ee49"

# Vala, with its UI in Blueprint. blueprint-compiler and sassc run on the
# build machine; blueprint reads the GTK and libadwaita typelibs from the
# stage. No PulseAudio widget (there's no libpulse, sound is PipeWire),
# no systemd unit: the session starts it, or D-Bus does on the first
# notification.
build() {
    # blueprint wants typelibs for everything Gtk pulls in (cairo, GLib,
    # Pango...), but the -gir packages only ship the .gir files, so
    # compile the missing ones here
    tl="$PWD/_typelib"
    mkdir -p "$tl"
    for gir in "$stage"/usr/share/gir-1.0/*.gir; do
        name=${gir##*/}
        name=${name%.gir}
        [ -e "$stage/usr/lib/girepository-1.0/$name.typelib" ] && continue
        "$work/native/bin/gi-compile-repository" \
            --includedir="$stage/usr/share/gir-1.0" \
            -o "$tl/$name.typelib" "$gir" 2>/dev/null || rm -f "$tl/$name.typelib"
    done
    PATH="$work/native/bin:$PATH" XDG_DATA_DIRS="$stage/usr/share" \
        GI_TYPELIB_PATH="$tl:$stage/usr/lib/girepository-1.0" \
        meson_build -Dsystemd-service=false -Dpulse-audio=false \
        -Dman-pages=false -Dzsh-completions=false -Dbash-completions=false \
        -Dfish-completions=false
    # swaync puts one stylesheet from /etc/xdg under yours, so Raye's
    # colours go at the end of the stock one
    cat "$files/raye.css" >> "$pkg/etc/xdg/swaync/style.css"
}
