version=0.15.0
release=3
description="waybar, the status bar"
depends="sys-libs/musl sys-libs/gcc-libs dev-cpp/gtkmm3 x11-libs/gtk3 gui-libs/gtk-layer-shell dev-cpp/glibmm dev-libs/libsigc++ dev-libs/jsoncpp dev-libs/spdlog dev-libs/fmt x11-libs/libxkbcommon dev-libs/wayland dev-libs/libinput sys-fs/eudev dev-libs/libevdev media-sound/pipewire media-sound/wireplumber"
makedepends="dev-cpp/gtkmm3 x11-libs/gtk3 gui-libs/gtk-layer-shell dev-cpp/glibmm dev-libs/libsigc++ dev-libs/jsoncpp dev-libs/spdlog dev-libs/fmt x11-libs/libxkbcommon dev-libs/wayland dev-libs/wayland-protocols dev-libs/libinput sys-fs/eudev dev-libs/libevdev media-sound/pipewire media-sound/wireplumber"
dynamic=1
source="git+https://github.com/Alexays/Waybar#90b209add8937514d0a987aa842e701bd8f1232e"

# sound goes through the WirePlumber module, there's no PulseAudio. No
# tray menus (libdbusmenu), batteries come from sysfs without UPower
build() {
    meson_build \
        -Dlibinput=enabled -Dlibudev=enabled -Dlibevdev=enabled \
        -Dpipewire=enabled -Dwireplumber=enabled -Drfkill=enabled \
        -Dlibnl=disabled -Dpulseaudio=disabled -Dupower_glib=disabled \
        -Dmpris=disabled -Dsystemd=disabled -Ddbusmenu-gtk=disabled \
        -Dmpd=disabled -Dsndio=disabled -Dlogind=disabled -Djack=disabled \
        -Dcava=disabled -Dgps=disabled -Dman-pages=disabled -Dtests=disabled
    # upstream's sample bar wants icon fonts and modules that aren't
    # built here, so Raye's goes in its place. Without swaync installed
    # its notification dot just stays empty
    rm -r "$pkg/etc"
    install -Dm644 "$files/config.jsonc" "$pkg/etc/xdg/waybar/config.jsonc"
    install -Dm644 "$files/style.css" "$pkg/etc/xdg/waybar/style.css"
}
