version=1.6.0
release=1
description="WebP images"
depends="musl"
dynamic=1
source="https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-$version.tar.gz"
sha256=e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564

build() {
    ./configure --host="$TARGET" --prefix=/usr --disable-static \
        --enable-libwebpmux --enable-libwebpdemux --enable-libwebpdecoder \
        --disable-gl --disable-sdl --disable-png --disable-jpeg --disable-tiff --disable-gif
    make -j"$JOBS"
    make DESTDIR="$pkg" install
    rm -rf "$pkg/usr/bin"
}
