version=1.18.6
release=1
description="2D drawing"
depends="musl pixman freetype fontconfig libpng zlib glib"
makedepends="pixman freetype fontconfig libpng zlib glib"
dynamic=1
source="https://cairographics.org/releases/cairo-$version.tar.xz"
sha256=1c767308174337a74694da0f3ec069c271452163a1ef4540964c50c301f157d4

# wayland only, so none of the X11 backends
build() {
    meson_build \
        -Dxlib=disabled \
        -Dxcb=disabled \
        -Dfreetype=enabled \
        -Dfontconfig=enabled \
        -Dpng=enabled \
        -Dglib=enabled \
        -Dzlib=enabled \
        -Dspectre=disabled \
        -Dsymbol-lookup=disabled \
        -Dtests=disabled
}
