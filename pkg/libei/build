version=1.6.0
release=1
description="emulated input, so remote desktop and the like can type"
depends="musl"
dynamic=1
source="git+https://gitlab.freedesktop.org/libinput/libei.git#8a46bf3d4b6af7f25a61be53386cf618218114ef"

# just libei and libeis; liboeffis wants systemd's D-Bus library. The
# debug tools would only drag libevdev and xkbcommon in
build() {
    meson_build \
        -Dliboeffis=disabled \
        -Dtests=disabled \
        -Ddocumentation=[]
    rm -rf "$pkg/usr/bin"
}
