version=0.9.13
release=1
description="the X render extension, for libXcursor"
depends="sys-libs/musl x11-libs/libx11"
makedepends="x11-libs/libx11 x11-base/xorgproto"
dynamic=1
source="https://www.x.org/releases/individual/lib/libXrender-$version.tar.xz"
sha256=3fe88c609df6782e1e7af2e4de36b2563d70cd70ff7dcb1cda561ad64912bb64

build() {
    ./configure --host="$TARGET" --prefix=/usr --disable-static
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
