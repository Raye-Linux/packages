version=1.58.2
release=1
description="the introspection data of Pango"
makedepends="dev-libs/glib media-libs/harfbuzz dev-libs/fribidi media-libs/fontconfig media-libs/freetype x11-libs/cairo dev-libs/glib-gir media-libs/harfbuzz-gir dev-libs/gobject-introspection"
dynamic=1
buildonly=1
source="https://download.gnome.org/sources/pango/${version%.*}/pango-$version.tar.xz"
sha256=342385b6ca3b7c73455d7c80a13b7dbe4489e00bc3bd4c5bd6ed4dce421e374a

# GTK 4's .gir includes Pango's. Same version as the pango package,
# built again with introspection, keeping only the .gir files
build() {
    meson setup _build --cross-file "$MESON_CROSS" \
        --native-file "$work/meson.native" \
        -Dintrospection=enabled -Dfontconfig=enabled -Dfreetype=enabled \
        -Dcairo=enabled -Dxft=disabled -Dlibthai=disabled \
        -Ddocumentation=false -Dman-pages=false -Dbuild-testsuite=false \
        -Dbuild-examples=false
    meson compile -C _build -j "$JOBS"
    DESTDIR="$PWD/_inst" meson install -C _build --no-rebuild
    mkdir -p "$pkg/usr/share"
    cp -a _inst/usr/share/gir-1.0 "$pkg/usr/share/"
}
