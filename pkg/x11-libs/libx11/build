version=1.8.14
release=1
description="the classic X client library"
depends="sys-libs/musl x11-libs/libxcb"
makedepends="x11-libs/libxcb x11-libs/xtrans x11-base/xorgproto"
dynamic=1
source="https://www.x.org/releases/individual/lib/libX11-$version.tar.xz"
sha256=bbc78c46217174655c2b32b138ad119f3ac15f50808b4d0b3a2677a4b1afc950

# there's no X server here. It's for libXcursor, which Hyprland loads
# cursor themes with
build() {
    ./configure --host="$TARGET" --prefix=/usr --disable-static \
        --disable-specs --without-xmlto --without-fop --disable-xf86bigfont
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
