version=1.0.12
release=1
description="X authorization, for libxcb"
depends="sys-libs/musl"
makedepends="x11-base/xorgproto"
dynamic=1
source="https://www.x.org/releases/individual/lib/libXau-$version.tar.xz"
sha256=74d0e4dfa3d39ad8939e99bda37f5967aba528211076828464d2777d477fc0fb

build() {
    ./configure --host="$TARGET" --prefix=/usr --disable-static
    make -j"$JOBS"
    make DESTDIR="$pkg" install
}
