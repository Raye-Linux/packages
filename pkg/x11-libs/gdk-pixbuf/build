version=2.44.8
release=1
description="image loading for GTK"
depends="sys-libs/musl dev-libs/glib media-libs/libpng media-libs/libjpeg-turbo x11-misc/shared-mime-info"
makedepends="dev-libs/glib media-libs/libpng media-libs/libjpeg-turbo x11-misc/shared-mime-info"
dynamic=1
source="https://download.gnome.org/sources/gdk-pixbuf/${version%.*}/gdk-pixbuf-$version.tar.xz"
sha256=919f529512961a12e81cd4b4b466a48c3933469e7f9a310c6513cd4fb252ba3c

# the classic loaders, built in, rather than glycin (Rust loaders in a
# bubblewrap sandbox). Built in means no loaders.cache to keep up to
# date, only librsvg's SVG loader needs one
build() {
    meson_build \
        -Dpng=enabled -Djpeg=enabled -Dgif=enabled -Dtiff=disabled \
        -Dglycin=disabled -Dothers=disabled \
        -Dbuiltin_loaders=png,jpeg,gif \
        -Dintrospection=disabled -Dman=false -Ddocumentation=false \
        -Dtests=false -Dinstalled_tests=false -Dthumbnailer=disabled
}
