version=2.4.134
release=1
description="talking to the kernel's graphics drivers"
depends="sys-libs/musl"
dynamic=1
source="https://dri.freedesktop.org/libdrm/libdrm-$version.tar.xz"
sha256=ac5e74d157830eb8bee44c6a6bf3ad49774ef0dd2a72bdad74a8f20308b52a95

# Mesa's Intel drivers do their own thing, none of the per-driver
# helper libraries are needed (and libdrm_intel wants libpciaccess)
build() {
    meson_build \
        -Dintel=disabled -Dradeon=disabled -Damdgpu=disabled \
        -Dnouveau=disabled -Dvmwgfx=disabled -Domap=disabled \
        -Dexynos=disabled -Dfreedreno=disabled -Dtegra=disabled \
        -Dvc4=disabled -Detnaviv=disabled \
        -Dvalgrind=disabled -Dcairo-tests=disabled -Dman-pages=disabled \
        -Dtests=false
}
