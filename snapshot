#!/bin/sh
#
# snapshot - sign a built repo and lay it out for publishing
#
# usage: snapshot [-r TAG] REPO KEY OUTDIR
#
# Copies REPO (what mkrepo or mklive built: the INDEX, PROFILES and the
# tarballs) into OUTDIR, signs the INDEX and PROFILES with KEY and checks
# the lot the way rpk will. OUTDIR is then a static repo: any web server
# can serve it as it is, and its URL works as REPO= for rpk.
#
# Name OUTDIR after the snapshot (mirror/snapshot-2026-10-24) and the
# folder it's in is a mirror for raye-update: snapshot writes
# latest/SNAPSHOT next to it, naming this one as the current snapshot.
# Serve that folder (nginx with root pointing at it is enough), and
# older snapshots can stay in it.
#
# -r TAG also publishes it as a pre-release of Raye-Linux/packages with
# that tag (snapshot-2026-10-24, say), using the gh command. One release
# per snapshot, the files the same ones as in OUTDIR, and the release
# called latest gets a SNAPSHOT naming TAG: that's how systems updating
# from GitHub find it.
#
# KEY is an ed25519 private key. To make one, and the public half that
# goes in /etc/rpk/keys on every system that should trust it:
#
#   openssl genpkey -algorithm ed25519 -out raye.key
#   openssl pkey -in raye.key -pubout -out raye.pub

set -e

msg() { printf '\033[1;35m=>\033[m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[m %s\n' "$*" >&2; exit 1; }

tag=
if [ "$1" = -r ]; then
    tag=$2
    shift 2
    [ -n "$tag" ] || die "-r needs a tag"
fi
[ "$#" -eq 3 ] || { sed -n '/^# usage/,/^#$/p' "$0" | sed -e '$d' -e 's/^# //'; exit 1; }
repo=$1 key=$2 out=$3

[ -s "$repo/INDEX" ] || die "no INDEX in $repo"
[ -f "$repo/PROFILES" ] || die "no PROFILES in $repo"
[ -s "$key" ] || die "no key at $key"
mkdir -p "$out"
[ -z "$(ls -A "$out")" ] || die "$out isn't empty"

# only what the INDEX lists, each one checked on the way
while IFS='|' read -r name ver sum _; do
    f=$(printf %s "$name" | tr / .)-$ver.tar.xz
    [ -f "$repo/$f" ] || die "the INDEX lists $f, but it isn't in $repo"
    [ "$(sha256sum "$repo/$f" | cut -d' ' -f1)" = "$sum" ] ||
        die "$f doesn't match its sum in the INDEX"
    cp "$repo/$f" "$out/"
done < "$repo/INDEX"
cp "$repo/INDEX" "$repo/PROFILES" "$out/"

openssl pkey -in "$key" -pubout -out "$out/key.pub"
for f in INDEX PROFILES; do
    openssl pkeyutl -sign -inkey "$key" -rawin -in "$out/$f" -out "$out/$f.sig"
    openssl pkeyutl -verify -pubin -inkey "$out/key.pub" -rawin \
        -in "$out/$f" -sigfile "$out/$f.sig" >/dev/null ||
        die "the signature doesn't check out against its own key"
done
# a list for mirrors that want to fetch it all, or to check a copy
(cd "$out" && sha256sum INDEX INDEX.sig PROFILES PROFILES.sig ./*.tar.xz |
    sed 's| \./| |' > SHA256SUMS)

# the mirror's pointer to its current snapshot
name=${out%/}
name=${name##*/}
mkdir -p "$out/../latest"
echo "$name" > "$out/../latest/SNAPSHOT"

msg "$(wc -l < "$out/INDEX") packages in $out, $(du -sh "$out" | cut -f1)"
msg "key.pub is the public half, for /etc/rpk/keys"
msg "$(cd "$out/.." && pwd)/latest/SNAPSHOT says $name"

[ -n "$tag" ] || exit 0
command -v gh >/dev/null || die "publishing needs gh, the GitHub command line tool"
msg "publishing $tag"
gh release create "$tag" --repo Raye-Linux/packages --prerelease \
    --title "$tag" \
    --notes "Built packages, $(wc -l < "$out/INDEX") of them. REPO=https://github.com/Raye-Linux/packages/releases/download/$tag" \
    "$out"/*

# and point latest at it, once the files are all there
up=$(mktemp -d)
echo "$tag" > "$up/SNAPSHOT"
gh release view latest --repo Raye-Linux/packages > /dev/null 2>&1 ||
    gh release create latest --repo Raye-Linux/packages --prerelease \
        --title latest --notes "SNAPSHOT names the current snapshot, for raye-update."
gh release upload latest "$up/SNAPSHOT" --repo Raye-Linux/packages --clobber
rm -r "$up"
msg "latest/SNAPSHOT on GitHub says $tag"
